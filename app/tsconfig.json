{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@schemas/*": ["../schemas/*"],
      "@hooks/*": ["./hooks/*"],
      "tailwind.config": ["./tailwind.config.js"],
      "@components/*": ["./components/*"],
      "@utils/*": ["./utils/*"],
      "@assets/*": ["./assets/*"],
      "@types/*": ["./types/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
